---
import { render, type CollectionEntry } from 'astro:content';
import { formatMonthYear, isoMonth } from '../lib/dates';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { title, institution, role, advisor, start, end, summary, tags } = entry.data;
const { Content } = await render(entry);
---

<article class="border-b border-rule py-8 first:pt-0 last:border-b-0">
  <header>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="font-serif text-xl leading-snug font-medium text-ink">{title}</h3>
      <p class="text-sm whitespace-nowrap text-ink-muted">
        <time datetime={isoMonth(start)}>{formatMonthYear(start)}</time>
        {' – '}
        {
          end ? (
            <time datetime={isoMonth(end)}>{formatMonthYear(end)}</time>
          ) : (
            <span>Present</span>
          )
        }
      </p>
    </div>

    <p class="mt-1 text-sm text-ink-muted">
      {role} · {institution}{advisor && <> · Supervisor: {advisor}</>}
    </p>
  </header>

  <p class="mt-3 text-ink">{summary}</p>

  <div class="mt-3 text-sm [&_li]:mt-1.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:text-ink-muted">
    <Content />
  </div>

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-full border border-rule px-2.5 py-0.5 text-xs text-ink-muted">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
