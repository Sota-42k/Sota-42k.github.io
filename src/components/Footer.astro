---
import { SITE } from '../lib/site';
import ContactIcon from './ContactIcon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-rule">
  <div
    class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-8 text-sm text-ink-muted"
  >
    <p>&copy; {year} {SITE.name}</p>
    <ul class="flex flex-wrap items-center gap-3">
      <li>
        <a
          href={`mailto:${SITE.email}`}
          aria-label="Email"
          title="Email"
          class="inline-flex size-9 items-center justify-center rounded text-ink-muted transition-colors hover:text-accent"
        >
          <ContactIcon name="email" />
        </a>
      </li>
      <li>
        <a
          href={SITE.github}
          rel="me noopener"
          target="_blank"
          aria-label="GitHub"
          title="GitHub"
          class="inline-flex size-9 items-center justify-center rounded text-ink-muted transition-colors hover:text-accent"
        >
          <ContactIcon name="github" />
        </a>
      </li>
      <li>
        <a
          href={SITE.linkedin}
          rel="me noopener"
          target="_blank"
          aria-label="LinkedIn"
          title="LinkedIn"
          class="inline-flex size-9 items-center justify-center rounded text-ink-muted transition-colors hover:text-accent"
        >
          <ContactIcon name="linkedin" />
        </a>
      </li>
      <li>
        <a
          href={SITE.orcid}
          rel="me noopener"
          target="_blank"
          aria-label="ORCID"
          title="ORCID"
          class="inline-flex size-9 items-center justify-center rounded text-ink-muted transition-colors hover:text-accent"
        >
          <ContactIcon name="orcid" />
        </a>
      </li>
      <li>
        <a
          href={SITE.researchGate}
          rel="me noopener"
          target="_blank"
          aria-label="ResearchGate"
          title="ResearchGate"
          class="inline-flex size-9 items-center justify-center rounded text-ink-muted transition-colors hover:text-accent"
        >
          <ContactIcon name="researchGate" />
        </a>
      </li>
    </ul>
  </div>
</footer>
