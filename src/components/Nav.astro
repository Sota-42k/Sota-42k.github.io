---
import { SITE, NAV_LINKS } from '../lib/site';

const { pathname } = Astro.url;
/** Normalize so '/research' and '/research/' compare equal. */
const current = pathname.replace(/\/+$/, '') || '/';
---

<header class="border-b border-rule">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-3xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-6 py-5"
  >
    <a href="/" class="font-serif text-lg font-semibold tracking-tight text-ink no-underline">
      {SITE.name}
    </a>
    <ul class="flex items-baseline gap-5 text-sm">
      {
        NAV_LINKS.map(({ href, label }) => {
          const isCurrent = current === href.replace(/\/+$/, '') || (href === '/' && current === '/');
          return (
            <li>
              <a
                href={href}
                aria-current={isCurrent ? 'page' : undefined}
                class:list={[
                  'no-underline transition-colors hover:text-accent',
                  isCurrent ? 'text-ink font-medium' : 'text-ink-muted',
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
