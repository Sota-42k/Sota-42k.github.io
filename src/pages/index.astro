---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { EDUCATION, SITE, RESEARCH_INTERESTS } from '../lib/site';
import { sortPublications } from '../lib/publications';
import portrait from '../assets/portrait-1.jpg';

const featured = sortPublications(
  await getCollection('publications', ({ data }) => data.featured)
);
---

<BaseLayout>
  <section>
    <!-- Keep the portrait beside the heading on wide screens. -->
    <div class="flex flex-col-reverse items-start gap-y-0 sm:flex-row sm:items-center sm:justify-between sm:gap-x-10">
      <div class="flex-1">
        <h1 class="font-serif text-4xl font-semibold tracking-tight text-ink">{SITE.name}</h1>
        <p class="mt-2 text-lg text-ink-muted">{SITE.tagline}</p>

        <div class="mt-5">
          <p class="text-sm text-ink-muted">{SITE.email.replace('@', ' [at] ')}</p>
          <ul aria-label="Contact and resources" class="mt-3 flex flex-wrap items-center gap-2">
            <li>
              <a
                href={SITE.github}
                rel="me noopener"
                target="_blank"
                aria-label="GitHub"
                title="GitHub"
                class="inline-flex size-10 items-center justify-center rounded-md border border-rule text-ink no-underline transition-colors hover:border-accent hover:text-accent"
              >
                <ContactIcon name="github" class="size-4" />
              </a>
            </li>
            <li>
              <a
                href={SITE.linkedin}
                rel="me noopener"
                target="_blank"
                aria-label="LinkedIn"
                title="LinkedIn"
                class="inline-flex size-10 items-center justify-center rounded-md border border-rule text-ink no-underline transition-colors hover:border-accent hover:text-accent"
              >
                <ContactIcon name="linkedin" class="size-4" />
              </a>
            </li>
            <li>
              <a
                href={SITE.orcid}
                rel="me noopener"
                target="_blank"
                aria-label="ORCID"
                title="ORCID"
                class="inline-flex size-10 items-center justify-center rounded-md border border-rule text-ink no-underline transition-colors hover:border-accent hover:text-accent"
              >
                <ContactIcon name="orcid" class="size-4" />
              </a>
            </li>
            <li>
              <a
                href={SITE.researchGate}
                rel="me noopener"
                target="_blank"
                aria-label="ResearchGate"
                title="ResearchGate"
                class="inline-flex size-10 items-center justify-center rounded-md border border-rule text-ink no-underline transition-colors hover:border-accent hover:text-accent"
              >
                <ContactIcon name="researchGate" class="size-4" />
              </a>
            </li>
            <li>
              <a
                href={SITE.cv}
                download
                class="inline-flex size-10 items-center justify-center rounded-md border border-rule text-sm text-ink no-underline transition-colors hover:border-accent hover:text-accent"
              >
                CV
              </a>
            </li>
          </ul>
        </div>
      </div>

      <Image
        src={portrait}
        alt={`Portrait of ${SITE.name}`}
        widths={[176, 208, 352, 416]}
        sizes="(min-width: 640px) 208px, 176px"
        format="webp"
        quality={82}
        width={416}
        height={575}
        loading="eager"
        fetchpriority="high"
        class="size-44 shrink-0 rounded-full border border-rule object-cover object-center sm:size-52"
      />
    </div>

    <div class="mt-6 w-full space-y-4 leading-relaxed text-ink">
      <p>
        I am a fourth-year undergraduate student at DePauw University majoring in Computer Science and
        Business Analytics with a focus on machine learning.
      </p>
      <p>
        My research interest is directed toward <strong class="font-medium">explainability in machine
        learning</strong>, particularly from the identifiability perspective. My current research focuses on
        the nonlinear ICA theory of score-based diffusion models.
      </p>
      <p>
        Looking ahead, I would like to apply identifiability theories to language models to develop
        theoretically explainable AI models. I am also interested in optimization of identifiable generative
        models, specifically in terms of identifiability-oriented loss function and estimation.
      </p>
    </div>
  </section>

  <section class="mt-14" aria-labelledby="interests">
    <h2 id="interests" class="font-serif text-2xl font-medium text-ink">Research interests</h2>
    <ul class="mt-4 space-y-2 text-ink-muted">
      {
        RESEARCH_INTERESTS.map((interest) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-rule">—</span>
            <span>{interest}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="selected">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="selected" class="font-serif text-2xl font-medium text-ink">Selected publications</h2>
      <a href="/publications" class="text-sm text-accent hover:underline">All publications →</a>
    </div>
    <div class="mt-4">
      {featured.map((entry) => <PublicationEntry entry={entry} />)}
    </div>
  </section>

  <section class="mt-14" aria-labelledby="education">
    <h2 id="education" class="font-serif text-2xl font-medium text-ink">Education</h2>
    <div class="mt-4 divide-y divide-rule">
      {
        EDUCATION.map(({ university, period, status }) => (
          <article class="py-4 first:pt-0 last:pb-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-medium text-ink">{university}</h3>
              <p class="text-sm text-ink-muted">{period}</p>
            </div>
            <p class="mt-1 text-sm text-ink-muted">{status}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
